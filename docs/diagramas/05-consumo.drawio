<mxfile host="Electron" version="26.0.0" modified="2026-10-29T00:00:00Z"><diagram id="05-consumo" name="Da quantidade ao registro alimentar"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Da quantidade ao registro alimentar" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Foto ainda não integra este fluxo. Uma busca ou rascunho não prova que a pessoa consumiu algo." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="selecionar versão" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="busca" target="form" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="revisão humana" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="form" target="confirmar" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="JSON" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="confirmar" target="api" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="transação" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="api" target="banco" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="resposta confirmada" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="banco" target="diario" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="busca" value="EXISTENTE&lt;br&gt;&lt;b&gt;Pesquisar&lt;/b&gt;&lt;br&gt;Nome/atalho → alimento e versão exatos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="form" value="EXISTENTE&lt;br&gt;&lt;b&gt;Preencher&lt;/b&gt;&lt;br&gt;Pessoa informa quantidade, unidade, horário e medida/estimativa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="confirmar" value="EXISTENTE&lt;br&gt;&lt;b&gt;Confirmar&lt;/b&gt;&lt;br&gt;POST privado; titular e chave idempotente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="api" value="EXISTENTE&lt;br&gt;&lt;b&gt;Validar e calcular&lt;/b&gt;&lt;br&gt;API preserva unidade, versão e desconhecidos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="banco" value="EXISTENTE&lt;br&gt;&lt;b&gt;Persistir&lt;/b&gt;&lt;br&gt;food_entries + vínculos em meal_items quando aplicável." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="diario" value="EXISTENTE&lt;br&gt;&lt;b&gt;Mostrar diário&lt;/b&gt;&lt;br&gt;Mesmos registros nas visões por refeição e por alimento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram></mxfile>
