<mxfile host="Electron" version="26.0.0" modified="2026-10-29T00:00:00Z"><diagram id="10-qualidade" name="Como uma alteração chega ao GitHub"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Como uma alteração chega ao GitHub" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Workflows usam filtros de caminhos; nem todos executam em todo commit. Sonar/carga/release integral ainda têm gates próprios." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="verificar" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="codigo" target="testes" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="validado" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="testes" target="commit" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="push" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="commit" target="ci" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="evidências" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="ci" target="artefato" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="testar jornada" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="artefato" target="aceite" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="codigo" value="EXISTENTE&lt;br&gt;&lt;b&gt;Código local&lt;/b&gt;&lt;br&gt;Flutter, Go, SQL e documentação." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="testes" value="EXISTENTE&lt;br&gt;&lt;b&gt;Validação local&lt;/b&gt;&lt;br&gt;Testes proporcionais, análise e revisão de segredos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="commit" value="EXISTENTE&lt;br&gt;&lt;b&gt;Commit e push&lt;/b&gt;&lt;br&gt;Incremento identificado; credenciais fora do Git." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="ci" value="EXISTENTE&lt;br&gt;&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;Flutter, Go/docs, SQL, catálogo, restore, imagem e segredos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="artefato" value="EXISTENTE&lt;br&gt;&lt;b&gt;Artefato de avaliação&lt;/b&gt;&lt;br&gt;APK por versão/hash; CI verde não é aceite humano." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="aceite" value="PARCIAL&lt;br&gt;&lt;b&gt;Aceite real&lt;/b&gt;&lt;br&gt;Emulador/celular; consentimentos e dados reais fornecidos pela pessoa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9c7b18;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram></mxfile>
