<mxfile host="Electron" version="26.0.0" modified="2026-10-29T00:00:00Z"><diagram id="03-telas" name="Mapa das telas ativas"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="1198" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Mapa das telas ativas" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Setas são navegação, não chamadas SQL. Biblioteca e fontes públicas também podem ser acessadas antes do login." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="sessão válida" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="inicio" target="hoje" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="consultar" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="hoje" target="biblioteca" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="avatar" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="hoje" target="perfil" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="alimentação" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="hoje" target="diario" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="adicionar" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="diario" target="busca" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="rotina" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="perfil" target="config" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="comprovação" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="perfil" target="fontes" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="conta" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="perfil" target="privacidade" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="inicio" value="EXISTENTE&lt;br&gt;&lt;b&gt;Inicialização / entrada&lt;/b&gt;&lt;br&gt;Restaura preferências e sessão; login é manual." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="hoje" value="EXISTENTE&lt;br&gt;&lt;b&gt;Hoje / ProductShell&lt;/b&gt;&lt;br&gt;Planos, atividade, alimentação e evolução; indisponibilidade explícita." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="biblioteca" value="EXISTENTE&lt;br&gt;&lt;b&gt;Biblioteca&lt;/b&gt;&lt;br&gt;Lista → detalhe; conteúdo de treino só para consulta." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="perfil" value="EXISTENTE&lt;br&gt;&lt;b&gt;Seu espaço&lt;/b&gt;&lt;br&gt;Conta, configuração, preferências, idioma e fontes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="diario" value="EXISTENTE&lt;br&gt;&lt;b&gt;Refeições e alimentos&lt;/b&gt;&lt;br&gt;Diário → refeição/item → correção ou exclusão confirmada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="busca" value="EXISTENTE&lt;br&gt;&lt;b&gt;Busca de alimentos&lt;/b&gt;&lt;br&gt;Pesquisar → detalhe → quantidade → confirmação." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell><mxCell id="config" value="EXISTENTE&lt;br&gt;&lt;b&gt;Configuração&lt;/b&gt;&lt;br&gt;Quatro etapas → revisão → confirmação." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="730" width="330" height="180" /></mxCell><mxCell id="fontes" value="EXISTENTE&lt;br&gt;&lt;b&gt;Fontes e transparência&lt;/b&gt;&lt;br&gt;Originais, autoria, licença e cálculo detalhado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="730" width="330" height="180" /></mxCell><mxCell id="privacidade" value="EXISTENTE&lt;br&gt;&lt;b&gt;Privacidade&lt;/b&gt;&lt;br&gt;Política; dados próprios e exclusão confirmada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="730" width="330" height="180" /></mxCell></root></mxGraphModel></diagram></mxfile>
