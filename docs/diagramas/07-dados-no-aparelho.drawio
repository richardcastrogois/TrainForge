<mxfile host="Electron" version="26.0.0" modified="2026-10-29T00:00:00Z"><diagram id="07-dados-no-aparelho" name="O que fica em cada lugar"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="824" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="O que fica em cada lugar" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Banco é fonte dos registros confirmados. Apagar dados do app não equivale a excluir a conta do servidor." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="API autenticada" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="seguro" target="db" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="confirmação explícita" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="memoria" target="db" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="metadados / futuro" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="fotos" target="db" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="reconciliação / futuro" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="offline" target="db" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="seguro" value="EXISTENTE&lt;br&gt;&lt;b&gt;Celular: seguro&lt;/b&gt;&lt;br&gt;Tokens da sessão; proteção fornecida pela plataforma." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="prefs" value="EXISTENTE&lt;br&gt;&lt;b&gt;Celular: preferências&lt;/b&gt;&lt;br&gt;Idioma e aparência; sem histórico alimentar autoritativo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="memoria" value="EXISTENTE&lt;br&gt;&lt;b&gt;Celular: memória&lt;/b&gt;&lt;br&gt;Formulários/intenções atuais; não é fila offline durável." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="db" value="EXISTENTE&lt;br&gt;&lt;b&gt;Servidor: PostgreSQL&lt;/b&gt;&lt;br&gt;Conta, registros, versões e vínculos de refeição." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="fotos" value="PLANEJADO&lt;br&gt;&lt;b&gt;Fotos recuperáveis&lt;/b&gt;&lt;br&gt;Arquivos privados por conta + cache; ainda não implementado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="offline" value="PLANEJADO&lt;br&gt;&lt;b&gt;Fila offline&lt;/b&gt;&lt;br&gt;Operações duráveis e isoladas por titular; ainda não implementado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram></mxfile>
