<mxfile host="Electron" version="26.0.0" modified="2026-10-29T00:00:00Z"><diagram id="02-arquitetura" name="Quem conversa com quem"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Quem conversa com quem" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="As duas bases usam o mesmo cluster PostgreSQL isolado15432 neste notebook. Isso não constitui isolamento de infraestrutura em&#10;produção." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="HTTP/JSON local" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="celular" target="api" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="HTTP interno" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="api" target="catalogo" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="pgx / SQL" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="api" target="core" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="pgx / SQL" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="catalogo" target="catdb" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="login consentido" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="celular" target="google" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="celular" value="EXISTENTE&lt;br&gt;&lt;b&gt;Flutter / Android&lt;/b&gt;&lt;br&gt;Interface no emulador. Porta8082 por adb reverse." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="api" value="EXISTENTE&lt;br&gt;&lt;b&gt;API Go :8082&lt;/b&gt;&lt;br&gt;Autenticação, regras privadas e composição dos serviços." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="catalogo" value="EXISTENTE&lt;br&gt;&lt;b&gt;Catálogo Go :18083&lt;/b&gt;&lt;br&gt;Leitura editorial separada; só quatro tabelas públicas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="google" value="EXTERNO&lt;br&gt;&lt;b&gt;Google OAuth&lt;/b&gt;&lt;br&gt;Pessoa escolhe conta; API verifica identidade." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#756080;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="core" value="EXISTENTE&lt;br&gt;&lt;b&gt;Banco do núcleo&lt;/b&gt;&lt;br&gt;trainforge_v1_dev; schema13;30tabelas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="catdb" value="EXISTENTE&lt;br&gt;&lt;b&gt;Banco do catálogo&lt;/b&gt;&lt;br&gt;trainforge_catalog_dev; schema2;4tabelas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram></mxfile>
