<mxfile host="Electron" version="26.0.0" modified="2026-10-29T00:00:00Z"><diagram id="01-produto" name="O que o TrainForge oferece"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="798" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="O que o TrainForge oferece" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Verde: existente; amarelo: parcial; tracejado: planejado. Casa, praça, academia, idosos e cuidador praticante continuam no&#10;escopo." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="titular" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="conta" target="diario" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="pré-requisito" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="config" target="treino" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="evolução" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="diario" target="foto" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="consulta" value="EXISTENTE&lt;br&gt;&lt;b&gt;Bibliotecas&lt;/b&gt;&lt;br&gt;Movimentos e alimentos reais; consulta pública." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="conta" value="EXISTENTE&lt;br&gt;&lt;b&gt;Conta pessoal&lt;/b&gt;&lt;br&gt;Google, sessão, privacidade e preferências." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="diario" value="PARCIAL&lt;br&gt;&lt;b&gt;Alimentação manual&lt;/b&gt;&lt;br&gt;Alimento próprio, consumo e refeições; aceite completo pendente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9c7b18;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="config" value="EXISTENTE&lt;br&gt;&lt;b&gt;Configuração de treino&lt;/b&gt;&lt;br&gt;Rotina, locais, recursos e disponibilidade." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="treino" value="PLANEJADO&lt;br&gt;&lt;b&gt;Treino completo&lt;/b&gt;&lt;br&gt;Selecionar, compor, agendar, executar e retomar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="foto" value="PLANEJADO&lt;br&gt;&lt;b&gt;Foto e análise&lt;/b&gt;&lt;br&gt;Candidatos editáveis, quantidade, fotos pela conta e dicas revisadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram></mxfile>
