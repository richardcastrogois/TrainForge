<mxfile host="Electron" version="26.0.0" modified="2026-10-29T00:00:00Z"><diagram id="06-catalogo" name="Publicação e leitura do catálogo"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Publicação e leitura do catálogo" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="M0–M4 fecham a primeira extração do catálogo. Comprar mídia não publica automaticamente programas ou doses." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="verificar" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="fonte" target="revisao" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="somente aprovado" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="revisao" target="pacote" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="versão" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="pacote" target="catalogo" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="cinco rotas" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="catalogo" target="api" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="referência" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="api" target="app" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="fonte" value="EXISTENTE&lt;br&gt;&lt;b&gt;Fonte e direitos&lt;/b&gt;&lt;br&gt;Autoria, licença, versão e uso permitido." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="revisao" value="PARCIAL&lt;br&gt;&lt;b&gt;Revisão humana&lt;/b&gt;&lt;br&gt;Separar movimento, instrução, mídia e programa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9c7b18;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="pacote" value="EXISTENTE&lt;br&gt;&lt;b&gt;Publicação editorial&lt;/b&gt;&lt;br&gt;Artefato/digest imutável; autoridade e retirada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="catalogo" value="EXISTENTE&lt;br&gt;&lt;b&gt;Catálogo separado&lt;/b&gt;&lt;br&gt;Leitor sem acesso às tabelas pessoais." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="api" value="EXISTENTE&lt;br&gt;&lt;b&gt;API / bridge&lt;/b&gt;&lt;br&gt;Confere autoridade atual; sem fallback automático antigo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="app" value="EXISTENTE&lt;br&gt;&lt;b&gt;Biblioteca&lt;/b&gt;&lt;br&gt;73movimentos consultáveis; zero programas liberados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram></mxfile>
