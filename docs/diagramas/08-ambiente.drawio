<mxfile host="Electron" version="26.0.0" modified="2026-10-29T00:00:00Z"><diagram id="08-ambiente" name="Iniciar, observar e parar"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Iniciar, observar e parar" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="status e plan-stop só consultam. Não executar init/activate/restore para abrir o app no dia a dia." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="ordem" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="start" target="db" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="ordem" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="db" target="catalogo" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="ordem" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="catalogo" target="api" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="ordem" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="api" target="android" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="salvar antes" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="android" target="stop" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="start" value="EXISTENTE&lt;br&gt;&lt;b&gt;ambiente start&lt;/b&gt;&lt;br&gt;Reutiliza ferramentas e configuração já existentes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="db" value="EXISTENTE&lt;br&gt;&lt;b&gt;1. PostgreSQL15432&lt;/b&gt;&lt;br&gt;Inicia apenas o cluster local registrado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="catalogo" value="EXISTENTE&lt;br&gt;&lt;b&gt;2. Catálogo18083&lt;/b&gt;&lt;br&gt;Reutiliza a base já provisionada; não ativa migrations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="api" value="EXISTENTE&lt;br&gt;&lt;b&gt;3. API8082&lt;/b&gt;&lt;br&gt;Watcher local; build e Swagger quando as fontes mudam." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="android" value="EXISTENTE&lt;br&gt;&lt;b&gt;4. Emulador / APK&lt;/b&gt;&lt;br&gt;TrainForge_Benchmark; instala somente se necessário." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="stop" value="EXISTENTE&lt;br&gt;&lt;b&gt;ambiente stop&lt;/b&gt;&lt;br&gt;API → catálogo → AVD registrado → banco; sem wipe." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram></mxfile>
