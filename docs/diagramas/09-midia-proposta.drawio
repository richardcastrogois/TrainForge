<mxfile host="Electron" version="26.0.0" modified="2026-10-29T00:00:00Z"><diagram id="09-midia-proposta" name="MoveKit: proposta de integração"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="876" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="MoveKit: proposta de integração" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Proposta, não infraestrutura existente. Cache/offline da mídia depende de esclarecer compatibilidade com a cláusula3 da&#10;licença." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="aquisição" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="compra" target="arquivo" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="conferência" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="arquivo" target="revisao" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="índice" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="revisao" target="metadados" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="mídia" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="revisao" target="objetos" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="API" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="metadados" target="app" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="stream autorizado" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="objetos" target="app" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="compra" value="PLANEJADO&lt;br&gt;&lt;b&gt;Compra manual&lt;/b&gt;&lt;br&gt;Ainda não realizada ou autorizada para execução." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="arquivo" value="EXTERNO&lt;br&gt;&lt;b&gt;Arquivos adquiridos&lt;/b&gt;&lt;br&gt;ZIP MP4; posters e metadados anunciados pelo fornecedor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#756080;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="revisao" value="PLANEJADO&lt;br&gt;&lt;b&gt;Importação revisada&lt;/b&gt;&lt;br&gt;Validar licença, identidade, tradução e versão." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="metadados" value="PLANEJADO&lt;br&gt;&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;IDs, relações, licença, versão e chave do objeto; não vídeos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="objetos" value="PLANEJADO&lt;br&gt;&lt;b&gt;Arquivos privados&lt;/b&gt;&lt;br&gt;Em dev: diretório local; futuro: object storage escolhido." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="app" value="PLANEJADO&lt;br&gt;&lt;b&gt;Player no aplicativo&lt;/b&gt;&lt;br&gt;Entrega controlada; sem links públicos ou download bruto." style="rounded=1;wh