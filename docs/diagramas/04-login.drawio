<mxfile host="Electron" version="26.0.0" modified="2026-10-29T00:00:00Z"><diagram id="04-login" name="Como a sessão nasce e continua"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Como a sessão nasce e continua" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Diagrama omite valores de tokens. Falha de rede não equivale a revogação; login real não é comprovado por fixtures." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="consentimento" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="pessoa" target="google" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="ID token" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="google" target="api" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="transação" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="api" target="banco" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="credenciais da sessão" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="banco" target="seguro" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="uso autenticado" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="seguro" target="sessao" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="pessoa" value="EXISTENTE&lt;br&gt;&lt;b&gt;Pessoa&lt;/b&gt;&lt;br&gt;Toca Entrar com Google e confirma sua conta." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="google" value="EXTERNO&lt;br&gt;&lt;b&gt;Google&lt;/b&gt;&lt;br&gt;Entrega uma identidade assinada; não uma sessão do TrainForge." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#756080;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="api" value="EXISTENTE&lt;br&gt;&lt;b&gt;POST auth/google&lt;/b&gt;&lt;br&gt;API confere assinatura, emissor, audiência e validade." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="banco" value="EXISTENTE&lt;br&gt;&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Usuário, família, access e refresh conforme o contrato." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="seguro" value="EXISTENTE&lt;br&gt;&lt;b&gt;Armazenamento seguro&lt;/b&gt;&lt;br&gt;Tokens no dispositivo; reset automático em erro desativado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="sessao" value="EXISTENTE&lt;br&gt;&lt;b&gt;Chamadas e renovação&lt;/b&gt;&lt;br&gt;Bearer nas rotas privadas; refresh rotativo; logout revoga." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram></mxfile>
