<mxfile host="Electron" version="26.0.0" modified="2026-11-16T00:00:00Z"><diagram id="01-produto" name="O que o TrainForge oferece"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="798" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="O que o TrainForge oferece" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Verde: existente; amarelo: parcial; tracejado: planejado. Casa, praça, academia, idosos e cuidador praticante continuam no&#10;escopo." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="titular" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="conta" target="diario" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="pré-requisito" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="config" target="treino" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="evolução" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="diario" target="foto" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="consulta" value="EXISTENTE&lt;br&gt;&lt;b&gt;Bibliotecas&lt;/b&gt;&lt;br&gt;Movimentos e alimentos reais; consulta pública." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="conta" value="EXISTENTE&lt;br&gt;&lt;b&gt;Conta pessoal&lt;/b&gt;&lt;br&gt;Google, sessão, privacidade e preferências." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="diario" value="PARCIAL&lt;br&gt;&lt;b&gt;Alimentação manual&lt;/b&gt;&lt;br&gt;Alimento próprio, consumo e refeições; aceite completo pendente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9c7b18;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="config" value="EXISTENTE&lt;br&gt;&lt;b&gt;Configuração de treino&lt;/b&gt;&lt;br&gt;Rotina, locais, recursos e disponibilidade." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="treino" value="PARCIAL&lt;br&gt;&lt;b&gt;Treino completo&lt;/b&gt;&lt;br&gt;Sessão persistida e tela única; adesão, conteúdo e agenda pendentes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9c7b18;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="foto" value="PLANEJADO&lt;br&gt;&lt;b&gt;Foto e análise&lt;/b&gt;&lt;br&gt;Candidatos editáveis, quantidade, fotos pela conta e dicas revisadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram><diagram id="02-arquitetura" name="Quem conversa com quem"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="1198" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Quem conversa com quem" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Código em integração: alimentação consulta SQLite e salva SQLCipher no aparelho; sync usa API própria. As bases PostgreSQL&#10;usam o mesmo cluster local15432. Ativação/global e Android têm gates no handoff." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="HTTP/JSON local" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="celular" target="api" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="HTTP interno" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="api" target="catalogo" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="pgx / SQL" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="api" target="core" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="pgx / SQL" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="catalogo" target="catdb" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="login consentido" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="celular" target="google" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="consulta local/FTS4" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="celular" target="foodsql" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="snapshot + operação durável" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="celular" target="privatefood" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="sync autenticada + revisão" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="privatefood" target="api" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="celular" value="EXISTENTE&lt;br&gt;&lt;b&gt;Flutter / Android&lt;/b&gt;&lt;br&gt;Interface móvel; busca alimentar offline; demais jornadas usam a API." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="api" value="EXISTENTE&lt;br&gt;&lt;b&gt;API Go :8082&lt;/b&gt;&lt;br&gt;Autenticação, regras privadas e composição dos serviços." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="catalogo" value="EXISTENTE&lt;br&gt;&lt;b&gt;Catálogo Go :18083&lt;/b&gt;&lt;br&gt;Leitura editorial separada; só quatro tabelas públicas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="google" value="EXTERNO&lt;br&gt;&lt;b&gt;Google OAuth&lt;/b&gt;&lt;br&gt;Pessoa escolhe conta; API verifica identidade." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#756080;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="core" value="EXISTENTE&lt;br&gt;&lt;b&gt;Banco do núcleo&lt;/b&gt;&lt;br&gt;trainforge_v1_dev; schema16/38tabelas. Ativação preservou as30tabelas anteriores." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="catdb" value="EXISTENTE&lt;br&gt;&lt;b&gt;Banco do catálogo&lt;/b&gt;&lt;br&gt;trainforge_catalog_dev; schema2;4tabelas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell><mxCell id="foodsql" value="PARCIAL&lt;br&gt;&lt;b&gt;SQLite público no aparelho&lt;/b&gt;&lt;br&gt;Catálogo gzip/Ed25519, TACO+USDA+OFF+legados; GTIN e porções. Pacote final em preparação." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9c7b18;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="730" width="330" height="180" /></mxCell><mxCell id="privatefood" value="PARCIAL&lt;br&gt;&lt;b&gt;SQLCipher por conta&lt;/b&gt;&lt;br&gt;Consumos, alimentos particulares, fila, conflitos e fotos de rótulo; chave no armazenamento seguro." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9c7b18;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="730" width="330" height="180" /></mxCell></root></mxGraphModel></diagram><diagram id="03-telas" name="Mapa das telas ativas"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="1198" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Mapa das telas ativas" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Setas são navegação, não chamadas SQL. Biblioteca e fontes públicas também podem ser acessadas antes do login." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="sessão válida" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="inicio" target="hoje" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="consultar" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="hoje" target="biblioteca" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="avatar" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="hoje" target="perfil" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="alimentação" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="hoje" target="diario" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="adicionar" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="diario" target="busca" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="rotina" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="perfil" target="config" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="comprovação" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="perfil" target="fontes" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="conta" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="perfil" target="privacidade" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="inicio" value="EXISTENTE&lt;br&gt;&lt;b&gt;Inicialização / entrada&lt;/b&gt;&lt;br&gt;Restaura preferências e sessão; login é manual." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="hoje" value="EXISTENTE&lt;br&gt;&lt;b&gt;Hoje / ProductShell&lt;/b&gt;&lt;br&gt;Cinco abas; Atividade mostra lista e sessão na mesma superfície." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="biblioteca" value="EXISTENTE&lt;br&gt;&lt;b&gt;Biblioteca&lt;/b&gt;&lt;br&gt;Lista → detalhe; conteúdo de treino só para consulta." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="perfil" value="EXISTENTE&lt;br&gt;&lt;b&gt;Seu espaço&lt;/b&gt;&lt;br&gt;Conta, configuração, preferências, idioma e fontes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="diario" value="EXISTENTE&lt;br&gt;&lt;b&gt;Refeições e alimentos&lt;/b&gt;&lt;br&gt;Diário → refeição/item → correção ou exclusão confirmada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="busca" value="EXISTENTE&lt;br&gt;&lt;b&gt;Busca de alimentos&lt;/b&gt;&lt;br&gt;Pesquisar → detalhe → quantidade → confirmação." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell><mxCell id="config" value="EXISTENTE&lt;br&gt;&lt;b&gt;Configuração&lt;/b&gt;&lt;br&gt;Quatro etapas → revisão → confirmação." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="730" width="330" height="180" /></mxCell><mxCell id="fontes" value="EXISTENTE&lt;br&gt;&lt;b&gt;Fontes e transparência&lt;/b&gt;&lt;br&gt;Originais, autoria, licença e cálculo detalhado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="730" width="330" height="180" /></mxCell><mxCell id="privacidade" value="EXISTENTE&lt;br&gt;&lt;b&gt;Privacidade&lt;/b&gt;&lt;br&gt;Política; dados próprios e exclusão confirmada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="730" width="330" height="180" /></mxCell></root></mxGraphModel></diagram><diagram id="04-login" name="Como a sessão nasce e continua"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Como a sessão nasce e continua" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Diagrama omite valores de tokens. Falha de rede não equivale a revogação; login real não é comprovado por fixtures." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="consentimento" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="pessoa" target="google" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="ID token" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="google" target="api" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="transação" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="api" target="banco" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="credenciais da sessão" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="banco" target="seguro" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="uso autenticado" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="seguro" target="sessao" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="pessoa" value="EXISTENTE&lt;br&gt;&lt;b&gt;Pessoa&lt;/b&gt;&lt;br&gt;Toca Entrar com Google e confirma sua conta." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="google" value="EXTERNO&lt;br&gt;&lt;b&gt;Google&lt;/b&gt;&lt;br&gt;Entrega uma identidade assinada; não uma sessão do TrainForge." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#756080;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="api" value="EXISTENTE&lt;br&gt;&lt;b&gt;POST auth/google&lt;/b&gt;&lt;br&gt;API confere assinatura, emissor, audiência e validade." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="banco" value="EXISTENTE&lt;br&gt;&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Usuário, família, access e refresh conforme o contrato." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="seguro" value="EXISTENTE&lt;br&gt;&lt;b&gt;Armazenamento seguro&lt;/b&gt;&lt;br&gt;Tokens no dispositivo; reset automático em erro desativado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="sessao" value="EXISTENTE&lt;br&gt;&lt;b&gt;Chamadas e renovação&lt;/b&gt;&lt;br&gt;Bearer nas rotas privadas; refresh rotativo; logout revoga." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram><diagram id="05-consumo" name="Da quantidade ao registro alimentar"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="876" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Da quantidade ao registro alimentar" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Fluxo alimentar offline em integração; snapshots preservam fonte/versão e o servidor confere paridade antes de confirmar.&#10;Aceite nativo e pacote completo pendentes." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="selecionar versão" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="busca" target="form" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="revisão humana" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="form" target="confirmar" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="sync autenticada quando conectado" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="confirmar" target="api" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="transação" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="api" target="banco" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="paridade + confirmação" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="banco" target="diario" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="salvo neste aparelho" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="confirmar" target="diario" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="busca" value="EXISTENTE&lt;br&gt;&lt;b&gt;Pesquisar offline&lt;/b&gt;&lt;br&gt;SQLite/FTS4 e GTIN; alimento e versão exatos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="form" value="EXISTENTE&lt;br&gt;&lt;b&gt;Preencher&lt;/b&gt;&lt;br&gt;Pessoa informa quantidade, unidade, horário e medida/estimativa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="confirmar" value="PARCIAL&lt;br&gt;&lt;b&gt;Salvar localmente&lt;/b&gt;&lt;br&gt;Transação SQLCipher: snapshot, cálculo e operação estável na fila." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9c7b18;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="api" value="EXISTENTE&lt;br&gt;&lt;b&gt;Sincronizar e conferir&lt;/b&gt;&lt;br&gt;Go revalida sessão/revisão e confere paridade antes de confirmar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="banco" value="EXISTENTE&lt;br&gt;&lt;b&gt;Persistir&lt;/b&gt;&lt;br&gt;food_entries + vínculos em meal_items quando aplicável." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="diario" value="PARCIAL&lt;br&gt;&lt;b&gt;Mostrar diário local&lt;/b&gt;&lt;br&gt;Mesmos registros nas duas visões; pendente ou confirmado explícitos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9c7b18;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram><diagram id="06-catalogo" name="Publicação e leitura do catálogo"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Publicação e leitura do catálogo" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="M0–M4 fecham a primeira extração do catálogo. Comprar mídia não publica automaticamente programas ou doses." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="verificar" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="fonte" target="revisao" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="somente aprovado" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="revisao" target="pacote" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="versão" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="pacote" target="catalogo" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="cinco rotas" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="catalogo" target="api" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="referência" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="api" target="app" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="fonte" value="EXISTENTE&lt;br&gt;&lt;b&gt;Fonte e direitos&lt;/b&gt;&lt;br&gt;Autoria, licença, versão e uso permitido." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="revisao" value="PARCIAL&lt;br&gt;&lt;b&gt;Revisão humana&lt;/b&gt;&lt;br&gt;Separar movimento, instrução, mídia e programa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9c7b18;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="pacote" value="EXISTENTE&lt;br&gt;&lt;b&gt;Publicação editorial&lt;/b&gt;&lt;br&gt;Artefato/digest imutável; autoridade e retirada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="catalogo" value="EXISTENTE&lt;br&gt;&lt;b&gt;Catálogo separado&lt;/b&gt;&lt;br&gt;Leitor sem acesso às tabelas pessoais." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="api" value="EXISTENTE&lt;br&gt;&lt;b&gt;API / bridge&lt;/b&gt;&lt;br&gt;Confere autoridade atual; sem fallback automático antigo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="app" value="EXISTENTE&lt;br&gt;&lt;b&gt;Biblioteca&lt;/b&gt;&lt;br&gt;73movimentos consultáveis; zero programas liberados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram><diagram id="07-dados-no-aparelho" name="O que fica em cada lugar"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="824" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="O que fica em cada lugar" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Banco é fonte dos registros confirmados. Apagar dados do app não equivale a excluir a conta do servidor." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="API autenticada" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="seguro" target="db" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="confirmação explícita" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="memoria" target="db" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="metadados / futuro" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="fotos" target="db" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="reconciliação / futuro" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="offline" target="db" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="seguro" value="EXISTENTE&lt;br&gt;&lt;b&gt;Celular: seguro&lt;/b&gt;&lt;br&gt;Tokens da sessão; proteção fornecida pela plataforma." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="prefs" value="EXISTENTE&lt;br&gt;&lt;b&gt;Celular: preferências&lt;/b&gt;&lt;br&gt;Idioma e aparência; sem histórico alimentar autoritativo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="memoria" value="EXISTENTE&lt;br&gt;&lt;b&gt;Celular: memória&lt;/b&gt;&lt;br&gt;Formulários/intenções atuais; não é fila offline durável." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="db" value="EXISTENTE&lt;br&gt;&lt;b&gt;Servidor: PostgreSQL&lt;/b&gt;&lt;br&gt;Conta, registros, versões e vínculos de refeição." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="fotos" value="PLANEJADO&lt;br&gt;&lt;b&gt;Fotos recuperáveis&lt;/b&gt;&lt;br&gt;Arquivos privados por conta + cache; ainda não implementado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="offline" value="PLANEJADO&lt;br&gt;&lt;b&gt;Fila offline&lt;/b&gt;&lt;br&gt;Operações duráveis e isoladas por titular; ainda não implementado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram><diagram id="08-ambiente" name="Iniciar, observar e parar"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Iniciar, observar e parar" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="status e plan-stop só consultam. Não executar init/activate/restore para abrir o app no dia a dia." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="ordem" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="start" target="db" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="ordem" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="db" target="catalogo" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="ordem" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="catalogo" target="api" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="ordem" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="api" target="android" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="salvar antes" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="android" target="stop" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="start" value="EXISTENTE&lt;br&gt;&lt;b&gt;ambiente start&lt;/b&gt;&lt;br&gt;Reutiliza ferramentas e configuração já existentes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="db" value="EXISTENTE&lt;br&gt;&lt;b&gt;1. PostgreSQL15432&lt;/b&gt;&lt;br&gt;Inicia apenas o cluster local registrado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="catalogo" value="EXISTENTE&lt;br&gt;&lt;b&gt;2. Catálogo18083&lt;/b&gt;&lt;br&gt;Reutiliza a base já provisionada; não ativa migrations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="api" value="EXISTENTE&lt;br&gt;&lt;b&gt;3. API8082&lt;/b&gt;&lt;br&gt;Watcher local; build e Swagger quando as fontes mudam." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="android" value="EXISTENTE&lt;br&gt;&lt;b&gt;4. Emulador / APK&lt;/b&gt;&lt;br&gt;TrainForge_Benchmark; instala somente se necessário." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="stop" value="EXISTENTE&lt;br&gt;&lt;b&gt;ambiente stop&lt;/b&gt;&lt;br&gt;API → catálogo → AVD registrado → banco; sem wipe." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram><diagram id="09-midia-proposta" name="MoveKit: proposta de integração"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="876" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="MoveKit: proposta de integração" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Proposta, não infraestrutura existente. Cache/offline da mídia depende de esclarecer compatibilidade com a cláusula3 da&#10;licença." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="aquisição" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="compra" target="arquivo" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="conferência" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="arquivo" target="revisao" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="índice" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="revisao" target="metadados" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="mídia" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="revisao" target="objetos" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="API" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="metadados" target="app" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="stream autorizado" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="objetos" target="app" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="compra" value="PLANEJADO&lt;br&gt;&lt;b&gt;Compra manual&lt;/b&gt;&lt;br&gt;Ainda não realizada ou autorizada para execução." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="arquivo" value="EXTERNO&lt;br&gt;&lt;b&gt;Arquivos adquiridos&lt;/b&gt;&lt;br&gt;ZIP MP4; posters e metadados anunciados pelo fornecedor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#756080;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="revisao" value="PLANEJADO&lt;br&gt;&lt;b&gt;Importação revisada&lt;/b&gt;&lt;br&gt;Validar licença, identidade, tradução e versão." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="metadados" value="PLANEJADO&lt;br&gt;&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;IDs, relações, licença, versão e chave do objeto; não vídeos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="objetos" value="PLANEJADO&lt;br&gt;&lt;b&gt;Arquivos privados&lt;/b&gt;&lt;br&gt;Em dev: diretório local; futuro: object storage escolhido." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="app" value="PLANEJADO&lt;br&gt;&lt;b&gt;Player no aplicativo&lt;/b&gt;&lt;br&gt;Entrega controlada; sem links públicos ou download bruto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#777777;fontSize=17;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram><diagram id="10-qualidade" name="Como uma alteração chega ao GitHub"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1230" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Como uma alteração chega ao GitHub" style="text;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1150" height="40" /></mxCell><mxCell id="note" value="Workflows usam filtros de caminhos; nem todos executam em todo commit. Sonar/carga/release integral ainda têm gates próprios." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1150" height="80" /></mxCell><mxCell id="e0" value="verificar" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="codigo" target="testes" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="validado" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="testes" target="commit" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="push" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="commit" target="ci" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="evidências" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="ci" target="artefato" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="testar jornada" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=13;endArrow=block;" edge="1" source="artefato" target="aceite" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="codigo" value="EXISTENTE&lt;br&gt;&lt;b&gt;Código local&lt;/b&gt;&lt;br&gt;Flutter, Go, SQL e documentação." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="330" height="180" /></mxCell><mxCell id="testes" value="EXISTENTE&lt;br&gt;&lt;b&gt;Validação local&lt;/b&gt;&lt;br&gt;Testes proporcionais, análise e revisão de segredos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="190" width="330" height="180" /></mxCell><mxCell id="commit" value="EXISTENTE&lt;br&gt;&lt;b&gt;Commit e push&lt;/b&gt;&lt;br&gt;Incremento identificado; credenciais fora do Git." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="190" width="330" height="180" /></mxCell><mxCell id="ci" value="EXISTENTE&lt;br&gt;&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;Flutter, Go/docs, SQL, catálogo, restore, imagem e segredos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="460" width="330" height="180" /></mxCell><mxCell id="artefato" value="EXISTENTE&lt;br&gt;&lt;b&gt;Artefato de avaliação&lt;/b&gt;&lt;br&gt;APK por versão/hash; CI verde não é aceite humano." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#52734d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="460" width="330" height="180" /></mxCell><mxCell id="aceite" value="PARCIAL&lt;br&gt;&lt;b&gt;Aceite real&lt;/b&gt;&lt;br&gt;Emulador/celular; consentimentos e dados reais fornecidos pela pessoa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9c7b18;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="460" width="330" height="180" /></mxCell></root></mxGraphModel></diagram><diagram id="11-banco-identidade" name="Banco: identidade e privacidade"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Banco: identidade e privacidade" style="text;html=1;whiteSpace=wrap;fontSize=1