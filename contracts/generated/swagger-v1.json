{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Actual local foundation; health endpoints only. No training/authentication functionality implied.",
        "title": "TrainForge API",
        "contact": {},
        "version": "0.1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/health/live": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "operation"
                ],
                "summary": "Process liveness",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.Status"
                        }
                    }
                }
            }
        },
        "/api/v1/health/ready": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "operation"
                ],
                "summary": "Database readiness",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.Status"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/httpapi.Problem"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "httpapi.Problem": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "requestId": {
                    "type": "string"
                },
                "status": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "httpapi.Status": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}