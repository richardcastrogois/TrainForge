# Real local values are written to .local/api.env, ignored by Git.
TF_ENV=development
TF_LISTEN_ADDR=127.0.0.1:8082
TF_SWAGGER=true
TF_DB_MAX_CONNS=10
TF_REQUEST_TIMEOUT_SECONDS=10
# TF_DATABASE_URL must use the isolated runtime role/database; no legacy DATABASE_URL fallback.
TF_DATABASE_URL=

# Public Web OAuth client ID. Empty means Google login unavailable; never a secret.
TF_GOOGLE_SERVER_CLIENT_ID=

# Optional signed food-catalog distribution, enabled only after exact SQL activation.
# Public artifacts only; keep all account files, credentials and signing secrets elsewhere.
TF_FOOD_CATALOG_DIRECTORY=
TF_FOOD_CATALOG_EXPORTS_DIRECTORY=
TF_FOOD_CATALOG_ARCHIVE_PATH=
